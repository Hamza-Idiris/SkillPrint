# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ---- MongoDB Atlas ----
MONGO_URI=

# ---- JWT ----
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Supabase Storage ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=skillsprint

# ---- Payments ----
# mock = simulated payments, no real money, no network calls (default)
# live = real WaafiPay charges
PAYMENT_MODE=mock

# ---- WaafiPay (only used when PAYMENT_MODE=live) ----
WAAFI_BASE_URL=http://sandbox.waafipay.net/asm
WAAFI_MERCHANT_UID=
WAAFI_API_USER_ID=
WAAFI_API_KEY=
WAAFI_DEFAULT_CURRENCY=USD

# ---- YouTube video upload (optional) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ---- Video stream token ----
STREAM_TOKEN_SECRET=
STREAM_TOKEN_TTL_SECONDS=60
